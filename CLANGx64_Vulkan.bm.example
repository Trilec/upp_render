BUILDER = "CLANG";
COMPILER = "";
COMMON_OPTIONS = "-mpopcnt";
COMMON_CPP_OPTIONS = "-std=c++17";
COMMON_C_OPTIONS = "";
COMMON_LINK = "";
COMMON_FLAGS = "";
DEBUG_INFO = "2";
DEBUG_BLITZ = "1";
DEBUG_LINKMODE = "0";
DEBUG_OPTIONS = "";
DEBUG_FLAGS = "";
DEBUG_LINK = "-Wl,--stack,20000000";
RELEASE_BLITZ = "1";
RELEASE_LINKMODE = "0";
RELEASE_OPTIONS = "-O3 ";
RELEASE_FLAGS = "";
RELEASE_LINK = "-Wl,--stack,20000000";
DEBUGGER = "gdb";
ALLOW_PRECOMPILED_HEADERS = "1";
DISABLE_BLITZ = "";
PATH = "<upp-root>/bin/clang/bin;<upp-root>/bin/clang/x86_64-w64-mingw32/bin;<vulkan-sdk>/Bin";
INCLUDE = "<vulkan-sdk>/Include";
LIB = "<vulkan-sdk>/Lib";
