#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(std430, binding=0) readonly buffer Edges { vec4 edges[]; };
layout(std430, binding=1) readonly buffer Rows { uint rows[]; };
struct Stop { vec4 rgba; float position; float p0, p1, p2; };
layout(std430, binding=2) readonly buffer Stops { Stop stops[]; };
layout(std430, binding=3) writeonly buffer Output { uint pixels[]; };
layout(push_constant) uniform Params {
    uint width, height, evenodd, kind;
    vec4 inverse_x, inverse_y, points;
    uint spread, stop_count, srgb, reserved;
} p;

int winding(vec2 q, uint offset, uint count) {
    int n=0;
    for(uint i=0; i<count; ++i) {
        vec4 e=edges[rows[offset+i]];
        if((e.y<=q.y && q.y<e.w) || (e.w<=q.y && q.y<e.y)) {
            float x=e.x+(q.y-e.y)*(e.z-e.x)/(e.w-e.y);
            if(x>q.x) n += e.w>e.y ? 1 : -1;
        }
    }
    return n;
}
bool inside(int n) { return p.evenodd!=0 ? (abs(n)&1)!=0 : n!=0; }
vec3 decode(vec3 c) {
    return mix(c/12.92, pow((c+0.055)/1.055, vec3(2.4)), greaterThan(c,vec3(0.04045)));
}
vec3 encode(vec3 c) {
    return mix(c*12.92, 1.055*pow(c,vec3(1.0/2.4))-0.055, greaterThan(c,vec3(0.0031308)));
}
vec4 colour(vec2 q) {
    vec4 c=stops[0].rgba;
    if(p.kind!=0) {
        vec2 local=vec2(dot(p.inverse_x.xy,q)+p.inverse_x.z,
                        dot(p.inverse_y.xy,q)+p.inverse_y.z);
        vec2 f=p.points.xy, end=p.points.zw, d=local-f;
        float t=0;
        if(p.kind==1) {
            vec2 axis=end-f; t=dot(d,axis)/max(dot(axis,axis),1e-20);
        } else if(p.kind==3) {
            const float tau=6.283185307179586;
            float sweep=min(abs(end.y),tau);
            float angle=atan(local.y,local.x);
            float phase=mod((end.y<0 ? -1 : 1)*(angle-end.x),tau);
            if(sweep>=tau-0.000001 || phase<=sweep) t=phase/sweep;
            else {
                float from_start=min(phase,tau-phase);
                float end_delta=abs(phase-sweep);
                float from_end=min(end_delta,tau-end_delta);
                t=from_start<=from_end ? 0 : 1;
            }
        } else {
            vec2 oc=f-end; float a=dot(d,d), b=dot(oc,d);
            float cc=dot(oc,oc)-p.inverse_x.w*p.inverse_x.w;
            float ray=a>1e-20 ? (sqrt(max(0,b*b-a*cc))-b)/a : 0;
            t=a<=1e-20 ? 0 : ray>=0.001 ? 1/ray : 1;
        }
        if(p.spread==1) t=fract(t);
        else if(p.spread==2) t=1-abs(mod(t,2)-1);
        else t=clamp(t,0,1);
        for(uint i=1; i<p.stop_count; ++i) {
            Stop a=stops[i-1], b=stops[i];
            if(t<=b.position || i+1==p.stop_count) {
                float u=b.position>a.position ? clamp((t-a.position)/(b.position-a.position),0,1) : 1;
                c=mix(a.rgba,b.rgba,u); break;
            }
        }
    }
    if(p.srgb!=0) c.rgb=decode(c.rgb);
    c.rgb*=c.a;
    return c;
}
// Integrate horizontal coverage exactly at each vertical sample. Most edge
// pixels have one crossing; this removes the old 32 x 32 font point grid.
// More than 32 crossings in one pixel uses the bounded point-grid fallback.
vec4 scanline(vec2 corner, float y, int samples, uint offset, uint count) {
    float crossings[32]; int directions[32]; int used=0, n=0; bool overflow=false;
    for(uint i=0; i<count; ++i) {
        vec4 e=edges[rows[offset+i]];
        if(!((e.y<=y && y<e.w) || (e.w<=y && y<e.y))) continue;
        float x=e.x+(y-e.y)*(e.z-e.x)/(e.w-e.y);
        int direction=e.w>e.y ? 1 : -1;
        if(x>corner.x) n+=direction;
        if(x>corner.x && x<corner.x+1) {
            if(used==32) { overflow=true; continue; }
            int at=used;
            while(at>0 && crossings[at-1]>x) {
                crossings[at]=crossings[at-1]; directions[at]=directions[at-1]; --at;
            }
            crossings[at]=x; directions[at]=direction; ++used;
        }
    }
    vec4 value=vec4(0);
    if(overflow) {
        for(int x=0; x<samples; ++x) {
            vec2 q=vec2(corner.x+(x+0.5)/samples,y);
            if(inside(winding(q,offset,count))) value+=colour(q)/samples;
        }
        return value;
    }
    float previous=corner.x;
    for(int i=0; i<used; ++i) {
        float x=crossings[i];
        if(inside(n)) value+=(x-previous)*colour(vec2((x+previous)*0.5,y));
        n-=directions[i]; previous=x;
    }
    if(inside(n)) value+=(corner.x+1-previous)*colour(vec2((corner.x+1+previous)*0.5,y));
    return value;
}
void main() {
    uvec2 id=gl_GlobalInvocationID.xy;
    if(id.x>=p.width || id.y>=p.height) return;
    uint row=(id.y/8)*2, offset=rows[row], count=rows[row+1];
    vec2 corner=vec2(id), centre=corner+0.5;
    bool boundary=false;
    for(uint i=0; i<count && !boundary; ++i) {
        vec4 e=edges[rows[offset+i]];
        float lo=max(min(e.y,e.w),corner.y), hi=min(max(e.y,e.w),corner.y+1);
        if(hi<lo) continue;
        float x0=e.x, x1=e.z;
        if(e.y!=e.w) {
            x0=e.x+(lo-e.y)*(e.z-e.x)/(e.w-e.y);
            x1=e.x+(hi-e.y)*(e.z-e.x)/(e.w-e.y);
        }
        boundary=max(x0,x1)>=corner.x && min(x0,x1)<=corner.x+1;
    }
    vec4 sum=vec4(0);
    if(!boundary) {
        if(inside(winding(centre,offset,count))) sum=colour(centre);
    } else {
        int samples=p.reserved==32 ? 32 : 8;
        for(int y=0; y<samples; ++y)
            sum+=scanline(corner,corner.y+(y+0.5)/samples,samples,offset,count)/samples;
    }
    if(p.srgb!=0) sum.rgb=encode(sum.rgb);
    uvec4 v=uvec4(round(clamp(sum,0,1)*255));
    pixels[id.y*p.width+id.x]=v.x|(v.y<<8)|(v.z<<16)|(v.w<<24);
}
